  ex:course ex:course1;
  ex:enrolledOn "2020-09-01"^^xsd:date;
  ex:grade 2 .

ex:enrollment2 a ex:Enrollment;
  ex:completedOn "2021-01-01"^^xsd:date;
  ex:course ex:course2;
  ex:enrolledOn "2020-09-01"^^xsd:date;
